PROJECT_NAME="Social Content & Post Microservice"
VERSION="1.0.0"
ENVIRONMENT=development
LOG_LEVEL=INFO
PORT=8000
HOST_PORT=8004

# Database Configuration (PostgreSQL)
POSTGRES_USER=post_user
POSTGRES_PASSWORD=replace_with_secure_postgres_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=post_service_db
DATABASE_URL=postgresql://post_user:replace_with_secure_postgres_password@postgres:5432/post_service_db

# Security & CORS (Must be replaced with a secure random key in production)
SECRET_KEY=replace_with_at_least_32_characters_random_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:8000,http://localhost:8000,http://localhost:5173,http://127.0.0.1:5173

# Inter-service Communication
USER_SERVICE_URL=http://user-service:8000

# Media Storage Configuration
STORAGE_TYPE=local
LOCAL_STORAGE_DIR=/app/uploads
